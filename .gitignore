# local database + runtime state
data/
*.db
*.db-wal
*.db-shm

# secrets — never commit
.env
# TLS certs: drop cert.pem + key.pem into ./certs/ and set PULSEMON_CERT/PULSEMON_KEY
certs/

# build artifacts
pulsemon
pulsemon-bin
pingmon
bin/
# prebuilt release binaries (release.sh builds fresh into dist/ — never commit)
pulsemon-linux-*
pulsemon-linux-*.sha256
# go-winres generated resource object (windows icon/version) — built, not committed
*.syso

# test files are COMMITTED since v0.2.3 (security test suite is public)

# local rollback backups — never publish
*.bak-*

# release build output
dist/
installer/output/
